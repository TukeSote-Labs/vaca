---
import Logo from "./Logo.astro";
import { normalizar, paginas } from "../lib/navegacion";

const enlaces = [
    ["/#caracteristicas", "Características"],
    ["/#codigo", "Código"],
    ["/#estado", "Estado"],
    ["/#instalar", "Instalar"],
];

const GITHUB = "https://github.com/ulf-frostypaw/vaca";
const enDocs = Astro.url.pathname.startsWith("/docs");
const actual = normalizar(Astro.url.pathname);
const esDocActiva = (href: string) => normalizar(href) === actual;
---

<header class="cabecera">
    <div class="contenedor interior">
        <a class="marca" href="/#inicio" aria-label="Vaca, volver al inicio">
            <Logo tamano={34} />
            <span class="nombre">Vaca</span>
            <span class="version">v0.1.0</span>
        </a>

        <nav class="navegacion" aria-label="Secciones del sitio">
            {enlaces.map(([href, texto]) => (
                <a href={href}>{texto}</a>
            ))}

            <details class="menu-docs">
                <summary class:list={["docs-boton", { activo: enDocs }]}>
                    <span>Docs</span>
                    <span class="flecha" aria-hidden="true">
                        ▾
                    </span>
                </summary>

                <div class="panel">
                    <p class="panel-titulo">Documentación</p>
                    <div class="panel-grupos">
                        {paginas.map((pagina) => {
                            const activa = esDocActiva(pagina.href);
                            return (
                                <a
                                    href={pagina.href}
                                    class:list={{ activo: activa }}
                                    aria-current={activa ? "page" : undefined}
                                >
                                    <span>{pagina.titulo}</span>
                                    <small>{pagina.descripcion}</small>
                                </a>
                            );
                        })}
                    </div>
                    <a class="panel-todos" href="/docs/">
                        Ver toda la documentación →
                    </a>
                </div>
            </details>
        </nav>

        <a class="github" href={GITHUB} target="_blank" rel="noreferrer">
            <svg viewBox="0 0 16 16" aria-hidden="true">
                <path
                    fill="currentColor"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                ></path>
            </svg>
            <span>GitHub</span>
        </a>
    </div>
</header>

<script>
    const menu = document.querySelector<HTMLDetailsElement>(".menu-docs");

    if (menu) {
        menu.querySelectorAll("a").forEach((enlace) => {
            enlace.addEventListener("click", () =>
                menu.removeAttribute("open"),
            );
        });

        document.addEventListener("click", (evento) => {
            if (
                menu.open &&
                evento.target instanceof Node &&
                !menu.contains(evento.target)
            ) {
                menu.open = false;
            }
        });

        document.addEventListener("keydown", (evento) => {
            if (evento.key === "Escape") menu.open = false;
        });
    }
</script>

<style>
    .cabecera {
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: var(--borde);
        background: var(--papel);
    }

    .interior {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: 4.6rem;
    }

    .marca {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--tinta);
        text-decoration: none;
    }

    .nombre {
        font-family: var(--display);
        font-size: 1.5rem;
        font-weight: 900;
        letter-spacing: -0.05em;
        line-height: 1;
        text-transform: uppercase;
    }

    .version {
        padding: 0.12rem 0.4rem;
        border: 2px solid var(--tinta);
        background: var(--cian);
        box-shadow: 2px 2px 0 var(--tinta);
        color: var(--tinta);
        font-family: var(--mono);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    .navegacion {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-left: auto;
    }

    .navegacion a {
        padding: 0.35rem 0.55rem;
        border: 2px solid transparent;
        color: var(--tinta);
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background 0.15s ease,
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            transform 0.15s ease;
    }

    .navegacion a:hover,
    .navegacion a.activo {
        border-color: var(--tinta);
        background: var(--amarillo);
        box-shadow: 3px 3px 0 var(--tinta);
        transform: translate(-1px, -1px);
    }

    .menu-docs {
        position: relative;
    }

    .docs-boton {
        display: inline-flex;
        align-items: center;
        gap: 0.32rem;
        padding: 0.35rem 0.55rem;
        border: 2px solid transparent;
        color: var(--tinta);
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 1.2;
        list-style: none;
        text-transform: uppercase;
        cursor: pointer;
        transition:
            background 0.15s ease,
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            transform 0.15s ease;
    }

    .docs-boton::-webkit-details-marker {
        display: none;
    }

    .docs-boton::marker {
        content: "";
    }

    .docs-boton:hover,
    .docs-boton.activo,
    .menu-docs[open] .docs-boton {
        border-color: var(--tinta);
        background: var(--amarillo);
        box-shadow: 3px 3px 0 var(--tinta);
        transform: translate(-1px, -1px);
    }

    .docs-boton:focus-visible,
    .panel a:focus-visible {
        outline: 3px solid var(--tinta);
        outline-offset: 1px;
    }

    .flecha {
        font-size: 0.6rem;
        line-height: 1;
        transition: transform 0.15s ease;
    }

    .menu-docs[open] .flecha {
        transform: rotate(180deg);
    }

    .panel {
        position: absolute;
        top: calc(100% + 0.8rem);
        right: 0;
        z-index: 60;
        display: grid;
        gap: 0.35rem;
        width: min(22rem, calc(100vw - 2rem));
        padding: 0.65rem;
        border: var(--borde);
        background: var(--blanco);
        box-shadow: var(--sombra);
    }

    .panel-titulo {
        margin: 0;
        padding: 0.2rem 0.35rem;
        background: var(--tinta);
        color: var(--amarillo);
        font-family: var(--mono);
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .panel-grupos {
        display: grid;
        gap: 0.15rem;
        max-height: min(60vh, 30rem);
        overflow-y: auto;
    }

    .panel-grupos a {
        display: block;
        padding: 0.42rem 0.5rem;
        border: 2px solid transparent;
        color: var(--tinta);
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
    }

    .panel-grupos a:hover {
        border-color: var(--tinta);
        background: var(--amarillo);
        box-shadow: 2px 2px 0 var(--tinta);
    }

    .panel-grupos a.activo {
        border-color: var(--tinta);
        background: var(--tinta);
        color: var(--amarillo);
    }

    .panel-grupos small {
        display: block;
        margin-top: 0.12rem;
        color: #6f6a61;
        font-size: 0.62rem;
        font-weight: 600;
        line-height: 1.25;
    }

    .panel-grupos a.activo small {
        color: var(--cian);
    }

    .panel-todos {
        margin-top: 0.1rem;
        padding: 0.45rem 0.5rem 0.2rem;
        border-top: 2px solid var(--tinta);
        color: var(--tinta);
        font-family: var(--mono);
        font-size: 0.64rem;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
    }

    .panel-todos:hover {
        background: var(--cian);
    }

    .github {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-left: 0.5rem;
        padding: 0.5rem 0.8rem;
        border: var(--borde);
        background: var(--tinta);
        box-shadow: 4px 4px 0 var(--rosa);
        color: var(--amarillo);
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }

    .github:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 var(--rosa);
    }

    .github svg {
        width: 1rem;
        height: 1rem;
    }

    @media (max-width: 900px) {
        .navegacion {
            margin-left: auto;
        }

        .navegacion > a {
            display: none;
        }

        .panel {
            position: fixed;
            top: 5.4rem;
            right: 0.75rem;
            left: 0.75rem;
            width: auto;
        }

        .github {
            margin-left: 0.35rem;
        }
    }

    @media (max-width: 520px) {
        .interior {
            gap: 0.5rem;
        }

        .version,
        .github span {
            display: none;
        }

        .nombre {
            font-size: 1.3rem;
        }
    }
</style>
