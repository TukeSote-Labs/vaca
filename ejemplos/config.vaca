# Lectura de configuración desde un archivo .env.
# Ejecuta: vaca ejemplos/config.vaca

importar sistema

CONFIG = sistema.cargar_env()

# Las variables de entorno reales tienen prioridad sobre el archivo.
HOST = sistema.env("HOST", CONFIG.obtener("HOST", "127.0.0.1"))
PUERTO = sistema.env("PUERTO", CONFIG.obtener("PUERTO", "8080"))
DEPURACION = CONFIG.obtener("DEPURACION", "falso") == "verdadero"

imprimir("Host:", HOST)
imprimir("Puerto:", PUERTO)
imprimir("¿Depuración?", DEPURACION)
imprimir("URL base:", CONFIG.obtener("URL_BASE", "http://localhost"))
imprimir("Etiqueta:", CONFIG.obtener("ETIQUETA"))
imprimir("Token:", CONFIG.obtener("TOKEN"))
imprimir("Conexión:", CONFIG.obtener("CONEXION"))
imprimir("¿SIN_VALOR está vacía?", CONFIG.obtener("SIN_VALOR", "(sin definir)") == "")

CLAVES = CONFIG.llaves()
CLAVES.ordenar()
imprimir("\nClaves cargadas:", CLAVES)

# Un archivo opcional que puede no existir: devuelve un diccionario vacío.
EXTRA = sistema.cargar_env(".env.local")
imprimir("Claves extra:", EXTRA.longitud())
