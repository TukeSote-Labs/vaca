# API HTTP con validación, JSON y rate limiting.
# Ejecuta: vaca ejemplos/servidor_api.vaca
# Prueba:  python3 scripts/probar_api.py

importar http
importar json
importar tiempo

productos = [
    {"id": 1, "nombre": "Teclado", "precio": 30},
    {"id": 2, "nombre": "Monitor", "precio": 180}
]
siguiente_id = 3
peticiones_por_ip = {}
limite_por_minuto = 20

fn limitar(ip) {
    ahora = tiempo.ahora()
    registro = peticiones_por_ip.get(ip, {"inicio": ahora, "cuenta": 0})
    si ahora - registro.inicio >= 60 {
        registro.inicio = ahora
        registro.cuenta = 0
    }
    registro.cuenta = registro.cuenta + 1
    peticiones_por_ip.set(ip, registro)
    retornar registro.cuenta <= limite_por_minuto
}

fn responder(estado, cuerpo) {
    retornar {"estado": estado, "cuerpo": cuerpo}
}

fn buscar_producto(id) {
    retornar productos.buscar(fn(p) { retornar p.id == id })
}

fn manejador(peticion) {
    si no limitar(peticion.ip) {
        retornar responder(429, {"error": "demasiadas peticiones"})
    }

    si peticion.metodo == "GET" y peticion.ruta == "/salud" {
        retornar responder(200, {
            "estado": "ok",
            "productos": productos.longitud(),
            "hora": tiempo.fecha_iso()
        })
    }

    si peticion.metodo == "GET" y peticion.ruta == "/api/productos" {
        nombre = peticion.consulta.get("nombre", "").recortar()
        si nombre == "" {
            retornar responder(200, {
                "productos": productos,
                "total": productos.longitud()
            })
        }
        buscados = productos.filtrar(fn(p) {
            retornar p.nombre.minusculas().contiene(nombre.minusculas())
        })
        retornar responder(200, {
            "productos": buscados,
            "total": buscados.longitud()
        })
    }

    si peticion.metodo == "GET" y peticion.ruta == "/api/productos/detalle" {
        id = entero(peticion.consulta.get("id", "0"))
        producto = buscar_producto(id)
        si producto == nulo {
            retornar responder(404, {"error": a"No existe el producto {id}"})
        }
        retornar responder(200, {"producto": producto})
    }

    si peticion.metodo == "POST" y peticion.ruta == "/api/productos" {
        intentar {
            datos = json.parse(peticion.cuerpo)
            si no datos.existe("nombre") {
                retornar responder(400, {"error": "falta el campo nombre"})
            }
            si no datos.existe("precio") {
                retornar responder(400, {"error": "falta el campo precio"})
            }
            nombre = datos.get("nombre").recortar()
            si nombre == "" {
                retornar responder(400, {"error": "el nombre no puede estar vacío"})
            }
            precio = decimal(datos.get("precio"))
            si precio < 0 {
                retornar responder(400, {"error": "el precio no puede ser negativo"})
            }

            producto = {
                "id": siguiente_id,
                "nombre": nombre,
                "precio": precio
            }
            siguiente_id = siguiente_id + 1
            productos.agregar(producto)
            retornar responder(201, {"producto": producto})
        } atrapar error {
            retornar responder(400, {"error": a"Petición inválida: {error}"})
        }
    }

    retornar responder(404, {
        "error": "ruta no encontrada",
        "metodo": peticion.metodo,
        "ruta": peticion.ruta
    })
}

imprimir("API Vaca en http://localhost:8081")
imprimir("GET  /salud")
imprimir("GET  /api/productos")
imprimir("GET  /api/productos?nombre=tec")
imprimir("GET  /api/productos/detalle?id=1")
imprimir("POST /api/productos  {\"nombre\":\"Cable\",\"precio\":5.5}")
http.servidor(8081, manejador)
